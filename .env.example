# Subscription: 7-day free trial, then USD 49.90 / month.
# The trial is FREE (USD 0.00) — no card, no PayPal charge during the 7 days.
# A paid month only starts if the merchant explicitly starts it after the
# trial. Paid monthly billing is not for sale yet (PayPal Subscriptions
# is not wired up), so PREP_BASE_PRICE_CENTS stays 0 and paid checkout
# stays disabled. Do not change the trial price to 990: that was the old
# paid-trial idea (USD 9.90 for 7 days) and is no longer the offer.
PREP_TRIAL_DAYS=7
PREP_TRIAL_PRICE_CENTS=0
PREP_MONTHLY_PRICE_CENTS=4990
PREP_BASE_PRICE_CENTS=0
PREP_CURRENCY=USD
PREP_INCLUDED_SKUS=50
PREP_OVERAGE_BLOCK_SIZE=50
# Leave this at 0. Catalogs with more than PREP_INCLUDED_SKUS rows still pay the
# base price. The paid pack includes the first 50 rows and says so.
PREP_OVERAGE_BLOCK_PRICE_CENTS=0

# Crawl and retention. Free audit product-page cap, paid sheet row cap, budget, retention.
PREP_MAX_PRODUCT_PAGES=30
PREP_MAX_INFO_PAGES=8
PREP_MAX_VARIANTS_PER_PRODUCT=40
PREP_MAX_FEED_ROWS=1000
PREP_AUDIT_BUDGET_MS=110000
PREP_FETCH_TIMEOUT_MS=12000
PREP_MAX_PAGE_BYTES=1500000
PREP_RETENTION_DAYS=30
PREP_MAX_UPLOAD_BYTES=5000000

# PayPal Checkout. Empty placeholders only. Never commit real values.
# PAYPAL_ENV=sandbox uses https://api-m.sandbox.paypal.com.
# PAYPAL_ENV=live uses https://api-m.paypal.com and charges real money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Private Vercel Blob stores the audit record and the pack files.
# On Vercel this is required. The app does not write to the local disk there.
# Postgres is optional and is not required for the free audit.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
DATABASE_URL=

# Optional public origin for the PayPal return and cancel URLs.
# On Vercel the incoming host is used when this is empty.
# PREP_PUBLIC_URL=https://chatgpt-business-prep.vercel.app

# Local filesystem store when Blob and DATABASE_URL are both unset.
# Paid PayPal checkout will not start in that mode.
# PREP_DATA_DIR=./data

# Lets local fixture stores be crawled. Forced off for PAYPAL_ENV=live and for
# a production deployment that has a price, even if this value is true.
PREP_ALLOW_LOOPBACK=true
