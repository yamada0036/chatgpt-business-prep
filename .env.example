# Test pricing. These are not a live price decision.
# Leave PREP_BASE_PRICE_CENTS unset or 0 until a price is chosen.
# The checkout page shows this amount, and simulated payment records the same amount.
PREP_BASE_PRICE_CENTS=0
PREP_CURRENCY=USD
PREP_INCLUDED_SKUS=50
PREP_OVERAGE_BLOCK_SIZE=50
PREP_OVERAGE_BLOCK_PRICE_CENTS=0

# Crawl and retention. Free audit product-page cap, paid sheet row cap, budget, retention.
PREP_MAX_PRODUCT_PAGES=30
PREP_MAX_INFO_PAGES=8
PREP_MAX_VARIANTS_PER_PRODUCT=40
PREP_MAX_FEED_ROWS=1000
PREP_AUDIT_BUDGET_MS=110000
PREP_FETCH_TIMEOUT_MS=12000
PREP_MAX_PAGE_BYTES=1500000
PREP_RETENTION_DAYS=30
PREP_MAX_UPLOAD_BYTES=5000000

# Allow http://127.0.0.1 fixture stores. Set to false before exposing this app.
PREP_ALLOW_LOOPBACK=true

# PREP_DATA_DIR=./data
